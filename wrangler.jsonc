{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tarifwerk",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/app-router-entry",
  "preview_urls": true,
  "assets": {
    "not_found_handling": "none"
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "PORTAL_OWNER_EMAIL": "m.egenolf@tarifwerk.eu",
    "TARIFWERK_AI_PROVIDER": "cloudflare",
    "TARIFWERK_PUBLIC_AI_PROVIDER": "cloudflare"
  }
}
