# Die produktiven Werte werden in der Serververwaltung oder in .env.local gesetzt.
# DATABASE_URL: bestehende PostgreSQL-Verbindungsadresse des Betreibers.
# SESSION_SECRET: dauerhaftes Geheimnis mit mindestens 32 zufälligen Zeichen;
# auf allen Instanzen identisch. Erzeugen mit:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
# PORTAL_ADMIN_PASSWORD: eigenes Passwort mit 12 bis 200 Zeichen für db:seed.
# Keine Standardpasswörter, Testzugänge oder erfundenen Verbindungen enthalten.
PORTAL_ADMIN_EMAIL=m.egenolf@tarifwerk.eu

# Optional: nur tatsächlich freigegebene Vorteilskonditionen hinterlegen (max. 500 Zeichen).
# REFERRAL_FRIEND_BENEFIT: vollständige Bedingungen für geworbene Kontakte.
# REFERRAL_REFERRER_BENEFIT: vollständige Bedingungen für die empfehlende Person.
# Ohne Werte werden keine pauschalen Rabatte oder Prämien zugesagt.
