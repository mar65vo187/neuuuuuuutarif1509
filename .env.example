# Vorlage für eine EIGENE PostgreSQL-Datenbank: nach .env.local kopieren und ausfüllen.
# Für die mitgelieferte lokale Datenbank stattdessen npm run env:init ausführen.
# Absichtlich keine gemeinsamen Zugangsdaten. Leere Pflichtwerte werden abgewiesen.
DATABASE_URL=
# Dauerhaftes Geheimnis mit mindestens 32 zufälligen Zeichen, auf allen Instanzen gleich.
SESSION_SECRET=
PORTAL_ADMIN_EMAIL=m.egenolf@tarifwerk.eu
# Optional separat setzen. Nur dieser Account darf interne Vergütungsstufen und Sparquoten ändern.
# Ohne Wert wird PORTAL_ADMIN_EMAIL als Owner verwendet.
PORTAL_OWNER_EMAIL=
# Nur für die Erstanlage oder einen ausdrücklich gewünschten Passwortwechsel (12–200 Zeichen).
PORTAL_ADMIN_PASSWORD=

# Optional: nur tatsächlich freigegebene Vorteilskonditionen hinterlegen (max. 500 Zeichen).
# REFERRAL_FRIEND_BENEFIT: vollständige Bedingungen für geworbene Kontakte.
# REFERRAL_REFERRER_BENEFIT: vollständige Bedingungen für die empfehlende Person.
# Ohne Werte werden keine pauschalen Rabatte oder Prämien zugesagt.


# Optional: Google Search Console HTML-Tag-Verifizierung.
# Nur den reinen content-Wert aus <meta name="google-site-verification" content="..."> eintragen.
GOOGLE_SITE_VERIFICATION=


# Required for the scheduled internal operations quality sweep.
# Use a long random value. Vercel Cron sends it as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
