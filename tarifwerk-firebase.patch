+import { ImageResponse } from "next/og";
+
+// Apple-Touch-Icon (iOS zeigt keine SVG-Icons an). Quelle: das Markenbild aus
+// public/favicon.svg, quadratisch aufbereitet und als JPEG eingebettet, damit
+// zur Laufzeit kein Dateizugriff nötig ist.
+const BRAND_MARK =
+  "data:image/jpeg;base64,";
+
+export const size = { width: 180, height: 180 };
+export const contentType = "image/png";
+
+export default function AppleIcon() {
+  return new ImageResponse(
+    (
+      <div
+        style={{
+          width: "100%",
+          height: "100%",
+          display: "flex",
+          backgroundColor: "#0c2140",
+          backgroundImage: `url(${BRAND_MARK})`,
+          backgroundSize: "180px 180px",
+          backgroundRepeat: "no-repeat",
+        }}
+      />
+    ),
+    size,
+  );
+}
